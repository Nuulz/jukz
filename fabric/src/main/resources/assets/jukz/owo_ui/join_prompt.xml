<!-- "Play together" (multiplayer screen): type a world code to join. Wired in JoinPromptScreen.kt. -->
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <template name="brand@jukz:theme"/>
                <template name="title@jukz:theme">
                    <id>title</id>
                </template>
                <template name="message@jukz:theme">
                    <id>message</id>
                </template>
                <text-box id="code">
                    <max-length>64</max-length>
                    <sizing>
                        <horizontal method="fixed">300</horizontal>
                        <vertical method="fixed">20</vertical>
                    </sizing>
                    <margins>
                        <vertical>4</vertical>
                    </margins>
                </text-box>
                <label id="error">
                    <color>#FFFF6B6B</color>
                </label>
                <template name="button-row@jukz:theme">
                    <id>buttons</id>
                </template>
            </children>
            <horizontal-alignment>center</horizontal-alignment>
            <gap>6</gap>
        </flow-layout>
    </components>
</owo-ui>

<!--
  Shared by every jukz status screen (searching, connecting, the host left, couldn't connect, …): brand,
  title, message, an optional progress bar and a row of buttons. JukzStatusScreen fills the text, the
  accent and the buttons; the look comes from theme.xml.
-->
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <template name="brand@jukz:theme"/>
                <template name="title@jukz:theme">
                    <id>title</id>
                </template>
                <template name="message@jukz:theme">
                    <id>message</id>
                </template>
                <template name="bar@jukz:theme">
                    <id>bar</id>
                    <width>160</width>
                    <height>3</height>
                </template>
                <template name="button-row@jukz:theme">
                    <id>buttons</id>
                </template>
            </children>
            <horizontal-alignment>center</horizontal-alignment>
            <gap>6</gap>
        </flow-layout>
    </components>
</owo-ui>

<!--
  "Saving your world to the cloud" (after a guest-less close). UploadingWorldScreen.kt drives the status
  line, the progress bar fill, the rotating tips and the late "Exit anyway" button.
-->
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <template name="brand@jukz:theme"/>
                <template name="title@jukz:theme">
                    <id>title</id>
                </template>
                <template name="message@jukz:theme">
                    <id>message</id>
                </template>
                <template name="bar@jukz:theme">
                    <id>bar</id>
                    <width>220</width>
                    <height>6</height>
                </template>
                <template name="hint@jukz:theme">
                    <id>tip</id>
                </template>
                <template name="button-row@jukz:theme">
                    <id>buttons</id>
                </template>
            </children>
            <horizontal-alignment>center</horizontal-alignment>
            <gap>6</gap>
        </flow-layout>
    </components>
</owo-ui>

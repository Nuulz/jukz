<!--
  Cosmetics (Multiplayer / title screen → "Cosmetics"). CosmeticsScreen.kt adds the 3D player preview,
  one tab per slot (badge, hat, face, back) and one "item-card" per catalog item of the open tab; each
  item is drawn from its ASCII art (badges) or its voxel slices (3D pieces) by ItemIcon.
-->
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <template name="brand@jukz:theme"/>
                <template name="title@jukz:theme">
                    <id>title</id>
                </template>
                <template name="message@jukz:theme">
                    <id>account</id>
                </template>

                <flow-layout direction="horizontal">
                    <children>
                        <!-- You, wearing your picks (drag to turn), and your tab-list line. -->
                        <flow-layout direction="vertical" id="preview-column">
                            <children>
                                <flow-layout direction="vertical" id="model">
                                    <children/>
                                    <sizing>
                                        <horizontal method="fixed">90</horizontal>
                                        <vertical method="fixed">118</vertical>
                                    </sizing>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <vertical-alignment>center</vertical-alignment>
                                </flow-layout>
                                <flow-layout direction="horizontal" id="preview">
                                    <children/>
                                    <gap>4</gap>
                                    <vertical-alignment>center</vertical-alignment>
                                    <padding>
                                        <vertical>2</vertical>
                                        <horizontal>4</horizontal>
                                    </padding>
                                    <surface>
                                        <flat>#80000000</flat>
                                    </surface>
                                </flow-layout>
                            </children>
                            <horizontal-alignment>center</horizontal-alignment>
                            <gap>4</gap>
                            <padding>
                                <all>4</all>
                            </padding>
                            <surface>
                                <flat>#55101828</flat>
                                <outline>#FF2A3B5C</outline>
                            </surface>
                        </flow-layout>

                        <flow-layout direction="vertical">
                            <children>
                                <!-- One button per slot, added from code. -->
                                <flow-layout direction="horizontal" id="tabs">
                                    <children/>
                                    <gap>3</gap>
                                </flow-layout>
                                <!-- Rows of item cards, added from code; two rows tall and scrolling, so the
                                     screen fits a 1080p window at GUI scale 4 however big the catalog grows. -->
                                <scroll direction="vertical">
                                    <flow-layout direction="vertical" id="grid">
                                        <children/>
                                        <gap>4</gap>
                                        <padding>
                                            <right>5</right>
                                        </padding>
                                    </flow-layout>
                                    <sizing>
                                        <horizontal method="content"/>
                                        <vertical method="fixed">104</vertical>
                                    </sizing>
                                    <scrollbar-thiccness>3</scrollbar-thiccness>
                                </scroll>
                            </children>
                            <gap>6</gap>
                        </flow-layout>
                    </children>
                    <gap>10</gap>
                    <margins>
                        <vertical>4</vertical>
                    </margins>
                </flow-layout>

                <template name="hint@jukz:theme">
                    <id>hint</id>
                </template>
                <template name="button-row@jukz:theme">
                    <id>buttons</id>
                </template>
            </children>
            <horizontal-alignment>center</horizontal-alignment>
            <gap>4</gap>
        </flow-layout>
    </components>

    <templates>
        <!-- One item. The icon goes into "icon-{{id}}"; the outline is recoloured from code (equipped / hover). -->
        <template name="item-card">
            <flow-layout direction="vertical" id="card-{{id}}">
                <children>
                    <flow-layout direction="horizontal" id="icon-{{id}}">
                        <children/>
                    </flow-layout>
                    <label id="state-{{id}}">
                        <color>#FF808080</color>
                    </label>
                </children>
                <sizing>
                    <horizontal method="fixed">52</horizontal>
                    <vertical method="fixed">50</vertical>
                </sizing>
                <horizontal-alignment>center</horizontal-alignment>
                <vertical-alignment>center</vertical-alignment>
                <gap>4</gap>
                <surface>
                    <flat>#66101828</flat>
                    <outline>#FF2A3B5C</outline>
                </surface>
            </flow-layout>
        </template>
    </templates>
</owo-ui>

<!--
  Your account (title screen → account icon, Singleplayer → "My account", Cosmetics → "My account").
  AccountScreen.kt fills the plan line, the two world lists ("in your cloud", "only on this PC") and the
  buttons; the look comes from theme.xml.
-->
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <template name="brand@jukz:theme"/>
                <template name="title@jukz:theme">
                    <id>title</id>
                </template>
                <template name="message@jukz:theme">
                    <id>plan</id>
                </template>
                <scroll direction="vertical">
                    <flow-layout direction="vertical" id="rows">
                        <children/>
                        <gap>3</gap>
                        <padding>
                            <right>5</right>
                        </padding>
                    </flow-layout>
                    <sizing>
                        <horizontal method="content"/>
                        <vertical method="fixed">118</vertical>
                    </sizing>
                    <scrollbar-thiccness>3</scrollbar-thiccness>
                    <margins>
                        <vertical>3</vertical>
                    </margins>
                </scroll>
                <template name="hint@jukz:theme">
                    <id>extras</id>
                </template>
                <template name="button-row@jukz:theme">
                    <id>buttons</id>
                </template>
            </children>
            <horizontal-alignment>center</horizontal-alignment>
            <gap>3</gap>
        </flow-layout>
    </components>

    <templates>
        <!-- A list heading ("In your cloud", "Only on this PC"). -->
        <template name="section">
            <label id="{{id}}">
                <color>#FF7FB2FF</color>
                <margins>
                    <top>4</top>
                </margins>
            </label>
        </template>

        <!-- One world: its name, a status line, and buttons added from code. -->
        <template name="world-row">
            <flow-layout direction="horizontal" id="row-{{id}}">
                <children>
                    <flow-layout direction="vertical">
                        <children>
                            <label id="name-{{id}}">
                                <color>#FFFFFFFF</color>
                                <shadow>true</shadow>
                            </label>
                            <label id="info-{{id}}">
                                <color>#FF808080</color>
                            </label>
                        </children>
                        <sizing>
                            <horizontal method="fixed">190</horizontal>
                        </sizing>
                        <gap>2</gap>
                    </flow-layout>
                    <flow-layout direction="horizontal" id="actions-{{id}}">
                        <children/>
                        <gap>3</gap>
                        <vertical-alignment>center</vertical-alignment>
                    </flow-layout>
                </children>
                <padding>
                    <all>4</all>
                </padding>
                <vertical-alignment>center</vertical-alignment>
                <surface>
                    <flat>#66101828</flat>
                    <outline>#FF2A3B5C</outline>
                </surface>
            </flow-layout>
        </template>
    </templates>
</owo-ui>

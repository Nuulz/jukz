<!--
  World info (pause menu → "World info (jukz)"). HostInfoScreen.kt fills the rows and wires the buttons
  by id; the look comes from theme.xml.
-->
<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <template name="brand@jukz:theme"/>
                <template name="title@jukz:theme">
                    <id>title</id>
                </template>

                <!-- One "info-row@jukz:theme" per field, added from code. -->
                <flow-layout direction="vertical" id="rows">
                    <children/>
                    <gap>5</gap>
                    <margins>
                        <vertical>8</vertical>
                    </margins>
                </flow-layout>

                <template name="button@jukz:theme">
                    <id>access-button</id>
                    <width>150</width>
                </template>
                <template name="button@jukz:theme">
                    <id>guests-button</id>
                    <width>200</width>
                </template>
                <template name="button-row@jukz:theme">
                    <id>buttons</id>
                </template>
            </children>
            <horizontal-alignment>center</horizontal-alignment>
            <gap>6</gap>
        </flow-layout>
    </components>
</owo-ui>

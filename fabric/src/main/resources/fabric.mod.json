{
  "schemaVersion": 1,
  "id": "jukz",
  "version": "${version}",
  "name": "jukz",
  "description": "Play with friends in the same world with no server: it opens on whoever is playing, passes to the next player when they leave, and waits in the cloud when everyone is gone.",
  "authors": ["Nobz"],
  "icon": "assets/jukz/icon.png",
  "contact": {
    "homepage": "https://nuulm.com/jukz",
    "sources": "https://github.com/Nuulz/jukz",
    "issues": "https://github.com/Nuulz/jukz/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "dev.jukz.JukzMod" }
    ],
    "client": [
      { "adapter": "kotlin", "value": "dev.jukz.JukzClient" }
    ],
    "modmenu": [
      { "adapter": "kotlin", "value": "dev.jukz.client.gui.JukzModMenu" }
    ]
  },
  "mixins": [
    "jukz.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.website": "https://nuulm.com/jukz",
        "modmenu.kofi": "https://ko-fi.com/nobmz"
      }
    }
  },
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.12.0",
    "owo-lib": ">=0.12.15"
  }
}
